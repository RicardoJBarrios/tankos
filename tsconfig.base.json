{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@tank-os/units": ["./libs/tank-os/units/src/index.ts"],
      "@tank-os/time": ["./libs/tank-os/time/src/index.ts"],
      "@tank-os/time/firestore": ["./libs/tank-os/time/src/firestore.ts"],
      "@tank-os/time/json-http": ["./libs/tank-os/time/src/json-http.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
