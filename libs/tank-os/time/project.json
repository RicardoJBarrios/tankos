{
  "name": "time",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tank-os/time/src",
  "prefix": "tankos",
  "projectType": "library",
  "tags": ["scope:tank-os", "type:feature"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/tank-os/time"],
      "options": {
        "command": "tsc --project libs/tank-os/time/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/tank-os/time",
        "coverage": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
