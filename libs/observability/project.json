{
  "name": "observability",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/observability/src",
  "projectType": "library",
  "tags": ["scope:shared", "scope:tankos", "type:infrastructure"],
  "// targets": "to see all targets run: nx show project observability --web",
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/observability/ng-package.json",
        "tsConfig": "libs/observability/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/observability/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "options": {
        "coverage": true,
        "coverage.reportsDirectory": "../../coverage/libs/observability"
      }
    }
  }
}
