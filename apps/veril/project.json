{
  "name": "veril",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "veril",
  "sourceRoot": "apps/veril/src",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/veril",
        "browser": "apps/veril/src/main.ts",
        "tsConfig": "apps/veril/tsconfig.app.json",
        "polyfills": ["zone.js"],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/veril/public"
          }
        ],
        "styles": [
          "apps/veril/src/material-theme.scss",
          "apps/veril/src/styles.css"
        ],
        "server": "apps/veril/src/main.server.ts",
        "ssr": true,
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/veril/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "veril:build:production"
        },
        "development": {
          "buildTarget": "veril:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "veril:build:development",
        "tsConfig": "apps/veril/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "exclude": ["**/*.integration.spec.ts"]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "veril:build",
        "staticFilePath": "dist/apps/veril/browser",
        "spa": true
      }
    }
  }
}
