{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "apps/**/src/main.ts",
    "apps/**/src/test-setup.ts",
    "apps/**/src/**/*.spec.ts",
    "apps/**/e2e/**/*.spec.ts",
    "apps/**/e2e/global-teardown.ts",
    "libs/**/src/index.ts",
    "libs/**/src/test-setup.ts",
    "libs/**/src/**/*.spec.ts",
    "tools/eslint/*-profiles.mjs",
    "tools/seed-units.mjs"
  ],
  "project": [
    "apps/**/src/**/*.{ts,tsx,html,css}",
    "apps/**/e2e/**/*.{ts,tsx}",
    "libs/**/src/**/*.{ts,tsx,html,css}",
    "apps/**/vite.config.mts",
    "libs/**/vite.config.mts",
    "tools/**/*.mjs",
    "tools/**/*.ts"
  ],
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/src/test-setup.ts",
    "**/*.integration.spec.ts"
  ],
  "ignoreDependencies": [
    "@tankos/*",
    "@angular/cli",
    "@angular/language-service",
    "@nx/js",
    "@nx/workspace",
    "@oxc-project/runtime",
    "@swc/helpers",
    "angular-eslint",
    "jsonc-eslint-parser",
    "ts-node",
    "@angular/platform-browser-dynamic",
    "@axe-core/playwright",
    "@typescript-eslint/utils",
    "autoprefixer"
  ],
  "ignoreUnresolved": ["src/test-setup.ts"],
  "ignoreBinaries": ["gitleaks"]
}
