rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEditorialKeeper() {
      return isAuthenticated()
        && request.auth.token.editorialAdmin == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(data) {
      return isAuthenticated() && data.ownerId == request.auth.uid;
    }

    function isValidLocation(location) {
      return location is map
        && location.keys().hasOnly(['latitude', 'longitude', 'displayName'])
        && location.keys().hasAll(['latitude', 'longitude', 'displayName'])
        && location.latitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude is number
        && location.longitude >= -180
        && location.longitude <= 180
        && location.displayName is string
        && location.displayName.size() > 0;
    }

    function isValidParameterTarget(target) {
      return target is map
        && target.keys().hasOnly(['minimum', 'maximum'])
        && target.keys().hasAll(['minimum', 'maximum'])
        && target.minimum is number
        && target.maximum is number
        && target.minimum >= 0
        && target.maximum >= 0
        && target.minimum <= target.maximum;
    }

    function isValidParameterTargets(targets) {
      return targets is map
        && targets.keys().hasOnly([
          'temperature',
          'salinity',
          'alkalinity',
          'nitrate',
          'phosphate'
        ])
        && (
          !targets.keys().hasAll(['temperature'])
          || isValidParameterTarget(targets.temperature)
        )
        && (
          !targets.keys().hasAll(['salinity'])
          || isValidParameterTarget(targets.salinity)
        )
        && (
          !targets.keys().hasAll(['alkalinity'])
          || isValidParameterTarget(targets.alkalinity)
        )
        && (
          !targets.keys().hasAll(['nitrate'])
          || isValidParameterTarget(targets.nitrate)
        )
        && (
          !targets.keys().hasAll(['phosphate'])
          || isValidParameterTarget(targets.phosphate)
        );
    }

    match /aquariums/{aquariumId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'name',
          'establishedBy',
          'establishedAt',
          'timeZone',
          'location'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId',
          'name',
          'establishedBy',
          'establishedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.establishedBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.establishedAt is timestamp
        && (
          !request.resource.data.keys().hasAll(['location'])
          || isValidLocation(request.resource.data.location)
        );

      allow read: if isOwner(resource.data);
      allow update: if isOwner(resource.data)
        && request.resource.data.keys().hasAll([
          'ownerId',
          'name',
          'establishedBy',
          'establishedAt'
        ])
        && (
          (
            !resource.data.keys().hasAll(['timeZone'])
            && request.resource.data.keys().hasAll(['timeZone'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeZone'])
            && request.resource.data.timeZone is string
            && request.resource.data.timeZone.size() > 0
          )
          || (
            !resource.data.keys().hasAll(['location'])
            && request.resource.data.keys().hasAll(['location'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['location'])
            && isValidLocation(request.resource.data.location)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parameterTargets'])
            && (
              !request.resource.data.keys().hasAll(['parameterTargets'])
              || isValidParameterTargets(request.resource.data.parameterTargets)
            )
          )
        );
      allow delete: if false;
    }

    match /observations/{observationId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'aquariumId',
          'ownerId',
          'content',
          'recordedAt'
        ])
        && request.resource.data.keys().hasAll([
          'aquariumId',
          'ownerId',
          'content',
          'recordedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.aquariumId is string
        && exists(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId))
        && get(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId)).data.ownerId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.recordedAt is timestamp;

      allow read: if isOwner(resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /measurements/{measurementId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'aquariumId',
          'ownerId',
          'parameterId',
          'enteredValue',
          'enteredUnit',
          'canonicalValue',
          'canonicalUnit',
          'measuredAt',
          'recordedAt',
          'provenance'
        ])
        && request.resource.data.keys().hasAll([
          'aquariumId',
          'ownerId',
          'parameterId',
          'enteredValue',
          'enteredUnit',
          'canonicalValue',
          'canonicalUnit',
          'measuredAt',
          'recordedAt',
          'provenance'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.aquariumId is string
        && exists(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId))
        && get(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId)).data.ownerId == request.auth.uid
        && request.resource.data.parameterId in [
          'temperature',
          'salinity',
          'alkalinity',
          'nitrate',
          'phosphate'
        ]
        && request.resource.data.enteredValue is number
        && request.resource.data.enteredValue >= 0
        && request.resource.data.canonicalValue is number
        && request.resource.data.canonicalValue >= 0
        && request.resource.data.enteredValue == request.resource.data.canonicalValue
        && request.resource.data.enteredUnit == request.resource.data.canonicalUnit
        && (
          (request.resource.data.parameterId == 'temperature'
            && request.resource.data.canonicalUnit == 'celsius')
          || (request.resource.data.parameterId == 'salinity'
            && request.resource.data.canonicalUnit == 'parts-per-thousand')
          || (request.resource.data.parameterId == 'alkalinity'
            && request.resource.data.canonicalUnit == 'degrees-kh')
          || (request.resource.data.parameterId == 'nitrate'
            && request.resource.data.canonicalUnit == 'milligrams-per-litre-as-no3')
          || (request.resource.data.parameterId == 'phosphate'
            && request.resource.data.canonicalUnit == 'milligrams-per-litre-as-po4')
        )
        && request.resource.data.measuredAt is timestamp
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.provenance == 'manual';

      allow read: if isOwner(resource.data);
      allow update, delete: if false;
    }

    match /careWorks/{careWorkId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'aquariumId',
          'ownerId',
          'description',
          'performedAt',
          'recordedAt',
          'provenance'
        ])
        && request.resource.data.keys().hasAll([
          'aquariumId',
          'ownerId',
          'description',
          'performedAt',
          'recordedAt',
          'provenance'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.aquariumId is string
        && exists(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId))
        && get(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId)).data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.performedAt is timestamp
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.provenance == 'manual';

      allow read: if isOwner(resource.data);
      allow update, delete: if false;
    }

    match /plannedCareWorks/{plannedCareWorkId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'aquariumId',
          'ownerId',
          'description',
          'plannedFor',
          'recordedAt',
          'provenance',
          'recurringCarePlanId'
        ])
        && request.resource.data.keys().hasAll([
          'aquariumId',
          'ownerId',
          'description',
          'plannedFor',
          'recordedAt',
          'provenance'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.aquariumId is string
        && exists(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId))
        && get(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId)).data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.plannedFor is timestamp
        && request.resource.data.recordedAt is timestamp
        && (
          request.resource.data.provenance == 'manual'
          && !request.resource.data.keys().hasAll(['recurringCarePlanId'])
          || (
            request.resource.data.provenance == 'recurring-plan'
            && request.resource.data.recurringCarePlanId is string
            && existsAfter(/databases/$(database)/documents/recurringCarePlans/$(request.resource.data.recurringCarePlanId))
            && getAfter(/databases/$(database)/documents/recurringCarePlans/$(request.resource.data.recurringCarePlanId)).data.ownerId == request.resource.data.ownerId
            && getAfter(/databases/$(database)/documents/recurringCarePlans/$(request.resource.data.recurringCarePlanId)).data.aquariumId == request.resource.data.aquariumId
            && getAfter(/databases/$(database)/documents/recurringCarePlans/$(request.resource.data.recurringCarePlanId)).data.outstandingPlannedCareWorkId == plannedCareWorkId
          )
        );

      allow read: if !exists(/databases/$(database)/documents/plannedCareWorks/$(plannedCareWorkId))
        || isOwner(resource.data);
      allow update: if false;
      allow delete: if isOwner(resource.data)
        && (
          (
            resource.data.provenance == 'manual'
            && (
              !existsAfter(/databases/$(database)/documents/careWorks/$(plannedCareWorkId))
              || (
                !exists(/databases/$(database)/documents/careWorks/$(plannedCareWorkId))
                && getAfter(/databases/$(database)/documents/careWorks/$(plannedCareWorkId)).data.ownerId == resource.data.ownerId
                && getAfter(/databases/$(database)/documents/careWorks/$(plannedCareWorkId)).data.aquariumId == resource.data.aquariumId
                && getAfter(/databases/$(database)/documents/careWorks/$(plannedCareWorkId)).data.description == resource.data.description
              )
            )
          )
          || (
            resource.data.provenance == 'recurring-plan'
            && resource.data.recurringCarePlanId is string
            && (
              !existsAfter(/databases/$(database)/documents/recurringCarePlans/$(resource.data.recurringCarePlanId))
              || getAfter(/databases/$(database)/documents/recurringCarePlans/$(resource.data.recurringCarePlanId)).data.outstandingPlannedCareWorkId != plannedCareWorkId
            )
          )
        );
    }

    match /recurringCarePlans/{recurringCarePlanId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'aquariumId',
          'ownerId',
          'description',
          'firstOccurrenceAt',
          'recordedAt',
          'outstandingPlannedCareWorkId'
        ])
        && request.resource.data.keys().hasAll([
          'aquariumId',
          'ownerId',
          'description',
          'firstOccurrenceAt',
          'recordedAt',
          'outstandingPlannedCareWorkId'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.aquariumId is string
        && exists(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId))
        && get(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId)).data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.firstOccurrenceAt is timestamp
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.outstandingPlannedCareWorkId is string
        && existsAfter(/databases/$(database)/documents/plannedCareWorks/$(request.resource.data.outstandingPlannedCareWorkId))
        && getAfter(/databases/$(database)/documents/plannedCareWorks/$(request.resource.data.outstandingPlannedCareWorkId)).data.recurringCarePlanId == recurringCarePlanId;

      allow read: if !exists(/databases/$(database)/documents/recurringCarePlans/$(recurringCarePlanId))
        || isOwner(resource.data);
      allow update: if isOwner(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstandingPlannedCareWorkId'])
        && request.resource.data.outstandingPlannedCareWorkId is string
        && existsAfter(/databases/$(database)/documents/plannedCareWorks/$(request.resource.data.outstandingPlannedCareWorkId))
        && getAfter(/databases/$(database)/documents/plannedCareWorks/$(request.resource.data.outstandingPlannedCareWorkId)).data.recurringCarePlanId == recurringCarePlanId
        && getAfter(/databases/$(database)/documents/plannedCareWorks/$(request.resource.data.outstandingPlannedCareWorkId)).data.ownerId == resource.data.ownerId
        && getAfter(/databases/$(database)/documents/plannedCareWorks/$(request.resource.data.outstandingPlannedCareWorkId)).data.aquariumId == resource.data.aquariumId;
      allow delete: if isOwner(resource.data)
        && !existsAfter(/databases/$(database)/documents/plannedCareWorks/$(resource.data.outstandingPlannedCareWorkId));
    }

    match /speciesProfiles/{speciesProfileId} {
      allow read: if resource.data.status == 'published'
        || isEditorialKeeper();
      allow write: if isEditorialKeeper();
    }

    match /speciesProfileDrafts/{speciesProfileId} {
      allow read, write: if isEditorialKeeper();
    }

    match /livestock/{livestockId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'aquariumId', 'ownerId', 'speciesProfileId', 'category',
          'representation', 'displayName', 'lifecycle', 'associatedAt',
          'updatedAt', 'associationHistory'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.lifecycle == 'active'
        && request.resource.data.aquariumId is string
        && request.resource.data.speciesProfileId is string
        && request.resource.data.category in ['fish', 'coral', 'other']
        && request.resource.data.representation in ['individual', 'group']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.associatedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.associationHistory is list
        && request.resource.data.associationHistory.size() > 0
        && exists(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId))
        && get(/databases/$(database)/documents/aquariums/$(request.resource.data.aquariumId)).data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/speciesProfiles/$(request.resource.data.speciesProfileId))
        && get(/databases/$(database)/documents/speciesProfiles/$(request.resource.data.speciesProfileId)).data.status == 'published';
      allow read: if isOwner(resource.data);
      allow update: if isOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aquariumId', 'lifecycle', 'updatedAt', 'associationHistory'
        ])
        && request.resource.data.associationHistory is list
        && request.resource.data.associationHistory.size() > 0
        && (request.resource.data.lifecycle == 'active' || request.resource.data.lifecycle == 'removed');
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
