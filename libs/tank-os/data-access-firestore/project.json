{
  "name": "data-access-firestore",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tank-os/data-access-firestore/src",
  "prefix": "tankos",
  "projectType": "library",
  "tags": ["scope:shared", "scope:tank-os", "type:adapter"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "dependsOn": ["data-access:build"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/tank-os/data-access-firestore/ng-package.json",
        "tsConfig": "libs/tank-os/data-access-firestore/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/tank-os/data-access-firestore/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/tank-os/data-access-firestore"
      ],
      "options": {
        "coverage": true,
        "coverage.reportsDirectory": "../../../coverage/libs/tank-os/data-access-firestore"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "",
        "command": "pnpm exec firebase emulators:exec --config libs/tank-os/data-access-firestore/emulator/emulator.firebase.json --project demo-veril --only firestore \"REQUIRE_FIRESTORE_EMULATOR=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 pnpm exec vitest run --config libs/tank-os/data-access-firestore/vite.config.mts libs/tank-os/data-access-firestore/src/lib/firestore/firestore-emulator.integration.spec.ts\""
      }
    }
  }
}
