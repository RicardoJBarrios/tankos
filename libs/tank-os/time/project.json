{
  "name": "time",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tank-os/time/src",
  "prefix": "tankos",
  "projectType": "library",
  "tags": ["scope:shared", "scope:tank-os", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/libs/tank-os/time"],
      "options": {
        "project": "libs/tank-os/time/ng-package.json",
        "tsConfig": "libs/tank-os/time/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/tank-os/time/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/tank-os/time"
      ],
      "options": {
        "coverage": true,
        "coverage.reportsDirectory": "../../../coverage/libs/tank-os/time"
      }
    }
  }
}
