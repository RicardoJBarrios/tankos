{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "apps/**/src/main.ts",
    "apps/**/src/main.server.ts",
    "apps/**/src/app/app.config.server.ts",
    "apps/**/src/test-setup.ts",
    "apps/**/src/**/*.spec.ts",
    "apps/**/e2e/**/*.spec.ts",
    "libs/**/src/index.ts",
    "libs/**/src/test-setup.ts",
    "libs/**/src/**/*.spec.ts",
    "tools/firebase/*.mjs"
  ],
  "project": [
    "apps/**/src/**/*.{ts,tsx,html,css}",
    "apps/**/e2e/**/*.{ts,tsx}",
    "libs/**/src/**/*.{ts,tsx,html,css}",
    "apps/**/vite.config.mts",
    "libs/**/vite.config.mts",
    "tools/**/*.mjs",
    "tools/**/*.ts"
  ],
  "ignore": [
    "apps/veril/**",
    "**/dist/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/src/test-setup.ts",
    "**/*.integration.spec.ts"
  ],
  "ignoreDependencies": [
    "@tankos/*",
    "@angular/cli",
    "@angular/language-service",
    "@angular/platform-browser-dynamic",
    "@eslint/js",
    "@nx/devkit",
    "@nx/js",
    "@nx/workspace",
    "@oxc-project/runtime",
    "@swc/helpers",
    "angular-eslint",
    "eslint-plugin-playwright",
    "jsonc-eslint-parser",
    "ts-node",
    "typescript-eslint"
  ],
  "ignoreUnresolved": ["src/test-setup.ts"],
  "ignoreBinaries": ["gitleaks"]
}
