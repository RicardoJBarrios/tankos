{
  "name": "veril",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "veril",
  "sourceRoot": "legacy/veril/src",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/legacy/veril",
        "browser": "legacy/veril/src/main.ts",
        "tsConfig": "legacy/veril/tsconfig.app.json",
        "polyfills": ["zone.js"],
        "assets": [
          {
            "glob": "**/*",
            "input": "legacy/veril/public"
          }
        ],
        "styles": [
          "legacy/veril/src/material-theme.scss",
          "legacy/veril/src/styles.css"
        ],
        "server": "legacy/veril/src/main.server.ts",
        "ssr": true,
        "outputMode": "static",
        "allowedCommonJsDependencies": ["@grpc/grpc-js", "@grpc/proto-loader"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "legacy/veril/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "veril:build:production"
        },
        "development": {
          "buildTarget": "veril:build:development"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "veril:build:development",
        "tsConfig": "legacy/veril/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "exclude": ["**/*.integration.spec.ts"]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "veril:build",
        "staticFilePath": "dist/legacy/veril/browser",
        "spa": true
      }
    }
  }
}
