rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(role) {
      return isPersistentUser()
        && request.auth.token.keys().hasAll(['roles'])
        && request.auth.token.roles is list
        && request.auth.token.roles.hasAll([role]);
    }

    function isAdmin() {
      return isPersistentUser()
        && (
          hasRole('admin')
          || (
            request.auth.token.keys().hasAll(['admin'])
            && request.auth.token.admin == true
          )
        );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPersistentUser() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasBoundedListQuery() {
      return request.query.limit != null
        && request.query.limit > 0
        && request.query.limit <= 51;
    }

    function isKeeper() {
      return isPersistentUser() && (hasRole('keeper') || isAdmin());
    }

    function isBoundedText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function isValidUnitRepresentation(data) {
      return data is map
        && data.keys().hasOnly(['symbol', 'asciiFallback', 'position', 'spacing'])
        && data.keys().hasAll(['symbol', 'asciiFallback', 'position', 'spacing'])
        && isBoundedText(data.symbol, 64)
        && isBoundedText(data.asciiFallback, 64)
        && data.position in ['prefix', 'suffix']
        && data.spacing in ['none', 'narrow', 'normal'];
    }

    function isValidSearchTokens(data) {
      // Rules cannot iterate list values; the schema boundary validates the
      // individual token strings. The size bound still prevents unbounded
      // index payloads from being accepted here.
      return data is list && data.size() <= 40000;
    }

    function isValidUnitDefinition(data) {
      return data is map
        && data.keys().hasAll(['visibility'])
        && data.keys().hasOnly([
          'storageId', 'code', 'ownerId', 'ownerName', 'codeSearchTokens',
          'ownerSearchTokens', 'visibility', 'system', 'representation',
          'catalogueVersion'
        ])
        && data.visibility in ['private', 'public']
        && isBoundedText(data.code, 128)
        && (
          !data.keys().hasAll(['storageId'])
          || isBoundedText(data.storageId, 256)
        )
        && isBoundedText(data.system, 64)
        && isValidUnitRepresentation(data.representation)
        && data.catalogueVersion is string
        && data.catalogueVersion.size() > 0
        && (
          data.visibility == 'public'
          || (
            data.keys().hasAll(['ownerId'])
            && isBoundedText(data.ownerId, 128)
          )
        )
        && (
          !data.keys().hasAll(['ownerName'])
          || data.ownerName == null
          || isBoundedText(data.ownerName, 256)
        )
        && (
          !data.keys().hasAll(['codeSearchTokens'])
          || isValidSearchTokens(data.codeSearchTokens)
        )
        && (
          !data.keys().hasAll(['ownerSearchTokens'])
          || isValidSearchTokens(data.ownerSearchTokens)
        );
    }

    function isValidUnitRecord(data) {
      return data is map
        && data.keys().hasOnly(['data', 'lifecycle', 'revision', 'metadata'])
        && data.keys().hasAll(['data', 'lifecycle', 'revision', 'metadata'])
        && isValidUnitDefinition(data.data)
        && data.lifecycle is map
        && data.lifecycle.keys().hasOnly(['status'])
        && data.lifecycle.status in [
          'active', 'inactive', 'marked-for-deletion', 'deleted'
        ]
        && data.revision is int
        && data.revision > 0
        && data.metadata is map
        && data.metadata.keys().hasOnly([
          'schemaVersion', 'createdAt', 'updatedAt', 'createdBy',
          'updatedBy', 'lifecycleChangedAt', 'lifecycleChangedBy'
        ])
        && data.metadata.keys().hasAll([
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.metadata.schemaVersion is int
        && data.metadata.schemaVersion > 0
        && data.metadata.createdAt is timestamp
        && data.metadata.updatedAt is timestamp
        && (!data.metadata.keys().hasAll(['createdBy'])
          || isBoundedText(data.metadata.createdBy, 128))
        && (!data.metadata.keys().hasAll(['updatedBy'])
          || isBoundedText(data.metadata.updatedBy, 128))
        && (!data.metadata.keys().hasAll(['lifecycleChangedAt'])
          || data.metadata.lifecycleChangedAt is timestamp)
        && (!data.metadata.keys().hasAll(['lifecycleChangedBy'])
          || isBoundedText(data.metadata.lifecycleChangedBy, 128));
    }

    function isPrivateUnitOwner(data) {
      return isKeeper()
        && isValidUnitDefinition(data)
        && data.visibility == 'private'
        && data.ownerId == request.auth.uid;
    }

    function isGlobalUnit(data) {
      return isKeeper()
        && isValidUnitDefinition(data)
        && data.visibility == 'public';
    }

    function isValidUnitLifecycleTransition(current, next) {
      return next == current
        || (current in ['active', 'inactive'] && next == 'marked-for-deletion')
        || (current == 'marked-for-deletion' && next == 'active');
    }

    function isStorageBoundUnit(unitId, data) {
      return data.keys().hasAll(['storageId']) && data.storageId == unitId;
    }

    function hasValidUnitUpdateAudit(current, next) {
      return next.revision == current.revision + 1
        && next.metadata.schemaVersion == current.metadata.schemaVersion
        && next.metadata.createdAt == current.metadata.createdAt
        && next.metadata.keys().hasAll(['updatedAt', 'updatedBy'])
        && next.metadata.updatedAt is timestamp
        && next.metadata.updatedBy == request.auth.uid
        && isValidUnitLifecycleTransition(
          current.lifecycle.status,
          next.lifecycle.status,
        )
        && (
          current.lifecycle.status == next.lifecycle.status
          || (
            next.metadata.keys().hasAll(['lifecycleChangedAt', 'lifecycleChangedBy'])
            && next.metadata.lifecycleChangedAt is timestamp
            && next.metadata.lifecycleChangedBy == request.auth.uid
          )
        );
    }

    // Unit definitions are private to their keeper until an admin publishes
    // them. Firebase Rules remains the authoritative resource boundary.
    match /units/{unitId} {
      // The create transaction reads a non-existent generated id first to
      // enforce idempotent conflict detection. That probe must not expose
      // existing unit data.
      allow get: if (
          !exists(/databases/$(database)/documents/units/$(unitId))
          && isKeeper()
        )
        || isAdmin()
        || isPrivateUnitOwner(resource.data.data)
        || isGlobalUnit(resource.data.data);
      allow list: if hasBoundedListQuery() && (isAdmin()
        || (isKeeper()
        && (
          resource.data.data.visibility == 'public'
          || (
            resource.data.data.visibility == 'private'
            && resource.data.data.ownerId == request.auth.uid
          )
        )));
      allow create: if isValidUnitRecord(request.resource.data)
        && isStorageBoundUnit(unitId, request.resource.data.data)
        && (
          isAdmin()
          || (
            isPrivateUnitOwner(request.resource.data.data)
            && request.resource.data.data.visibility == 'private'
          )
        );
      allow update: if isValidUnitRecord(request.resource.data)
        && isStorageBoundUnit(unitId, request.resource.data.data)
        && request.resource.data.data.code == resource.data.data.code
        && hasValidUnitUpdateAudit(resource.data, request.resource.data)
        && (
          isAdmin()
          || (
            isPrivateUnitOwner(resource.data.data)
            && isPrivateUnitOwner(request.resource.data.data)
            && request.resource.data.data.ownerId == resource.data.data.ownerId
            && request.resource.data.data.visibility == resource.data.data.visibility
          )
        );
      allow delete: if (
        resource.data.lifecycle.status in ['marked-for-deletion', 'deleted']
        && (isAdmin() || isPrivateUnitOwner(resource.data.data))
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
