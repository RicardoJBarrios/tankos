{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "bash ./tools/dev.sh",
    "firebase:set-keeper-claim": "node tools/firebase/set-keeper-claim.mjs",
    "firebase:set-editorial-claim": "node tools/firebase/set-editorial-claim.mjs",
    "quality:format": "prettier --check 'apps/tankos/**/*.{ts,html,css,mts}' 'libs/**/*.{ts,html,css,mts}' 'tools/**/*.{ts,mts,js,mjs}' '*.{mjs,ts,json,yml}'",
    "quality:knip": "knip --no-progress --include files,dependencies,unlisted,unresolved,binaries",
    "quality:semgrep": "bash ./tools/quality/run-semgrep.sh",
    "quality:gitleaks": "gitleaks dir . --config .gitleaks.toml --no-banner --redact && gitleaks git . --config .gitleaks.toml --no-banner --redact",
    "quality:audit": "pnpm audit --prod --audit-level high",
    "quality:nx": "pnpm exec nx run-many -t lint test build --parallel=3 --skipNxCache",
    "quality:affected": "pnpm exec nx affected -t lint test build --parallel=3 --skipNxCache",
    "quality:local": "pnpm quality:format && pnpm quality:nx && pnpm quality:knip && pnpm quality:semgrep && pnpm quality:gitleaks && pnpm quality:audit",
    "quality:sonar": "bash ./tools/quality/sonar-scan.sh",
    "quality:all": "pnpm quality:local && pnpm quality:sonar"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.3",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/platform-server": "22.1.3",
    "@angular/router": "22.1.3",
    "@angular/service-worker": "22.1.3",
    "@angular/ssr": "22.1.3",
    "@ngrx/signals": "22.0.0",
    "big.js": "7.0.1",
    "firebase": "12.17.1",
    "marked": "13.0.3",
    "rxjs": "~7.8.0",
    "zod": "4.4.3",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@analogjs/vitest-angular": "2.7.0",
    "@angular-devkit/architect": "0.2201.3",
    "@angular-devkit/build-angular": "22.1.3",
    "@angular-devkit/core": "22.1.3",
    "@angular-devkit/schematics": "22.1.3",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/language-service": "22.1.3",
    "@axe-core/playwright": "^4.13.0",
    "@e18e/eslint-plugin": "^0.8.0",
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@ngneat/spectator": "20.0.0",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
