{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@tankos/units": ["./libs/units/src/index.ts"],
      "@tankos/time": ["./libs/time/src/index.ts"],
      "@tankos/decimal": ["./libs/decimal/src/index.ts"],
      "@tankos/data-access": ["./libs/data-access/src/index.ts"],
      "@tankos/data-access-firestore": [
        "./libs/data-access-firestore/src/index.ts"
      ],
      "@tankos/data-access-json-http": [
        "./libs/data-access-json-http/src/index.ts"
      ],
      "@tankos/data-access-server": ["./libs/data-access-server/src/index.ts"],
      "@tankos/time-firestore": ["./libs/time-firestore/src/index.ts"],
      "@tankos/time-json-http": ["./libs/time-json-http/src/index.ts"],
      "@tankos/time-zod": ["./libs/time-zod/src/index.ts"],
      "@tankos/decimal-big-js": ["./libs/decimal-big-js/src/index.ts"],
      "@tankos/decimal-zod": ["./libs/decimal-zod/src/index.ts"],
      "@tankos/data-access-firestore-admin": [
        "./libs/data-access-firestore-admin/src/index.ts"
      ],
      "@tankos/units-zod": ["./libs/units-zod/src/index.ts"],
      "@tankos/units-firestore": ["./libs/units-firestore/src/index.ts"],
      "@tankos/units-json-http": ["./libs/units-json-http/src/index.ts"],
      "@tankos/data-access-ui": ["./libs/data-access-ui/src/index.ts"],
      "@tankos/formatting": ["./libs/formatting/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
